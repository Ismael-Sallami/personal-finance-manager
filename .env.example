# ============================================================
#  Personal Finance Manager - configuration
#  Copy this file to .env and fill in the values.
#  NEVER commit .env.
# ============================================================

# --- Database ---
# Any Postgres works. With Supabase: Settings -> Database -> Connection string
# (URI), "Session pooler" mode. Add ?sslmode=require for an encrypted connection.
# Example:
# DATABASE_URL=postgresql+psycopg2://user:PASSWORD@host:5432/postgres?sslmode=require
#
# Leave it empty and the app falls back to a local SQLite file (dev.db).
DATABASE_URL=

# --- Security ---
# Generate a random key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-key

# true in production (HTTPS). On local http keep it false or the cookie is dropped.
COOKIE_SECURE=false
# true in production: hides /docs and enables HSTS.
IS_PROD=false

# --- Single user (created by scripts/seed.py) ---
APP_USER_EMAIL=you@example.com
APP_USER_PASSWORD=change-this-password

# --- Display ---
# Name printed on generated reports.
REPORT_OWNER=Account owner
# Symbol used everywhere money is shown.
CURRENCY_SYMBOL=€
# Timezone the scheduled jobs run in (IANA name, e.g. Europe/Madrid).
TIMEZONE=UTC

# --- Investments: ISIN -> ticker lookup (OpenFIGI, optional) ---
# Works without a key (rate limited). Free key at https://www.openfigi.com/api.
OPENFIGI_API_KEY=

# --- Telegram bot (optional) ---
# 1) Create the bot with @BotFather and paste the token here.
# 2) Your chat_id: message the bot and read the logs, or use @userinfobot.
# 3) Webhook secret: python -c "import secrets; print(secrets.token_hex(16))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Public URL used to register the webhook in production.
# Example: https://your-service.onrender.com
PUBLIC_BASE_URL=

# --- Scheduled tasks ---
# In-process scheduler: true only on always-on hosts. On free tiers where the app
# sleeps, keep it false and drive /tasks/* from an external cron.
USE_SCHEDULER=false
# Token that authorises the external cron: python -c "import secrets; print(secrets.token_hex(16))"
# Empty = /tasks/* endpoints disabled.
TASKS_TOKEN=

# --- How entries get in: manual or bank mode (see docs/BANK_SYNC.md) ---
# manual: keep notes and paste them to the bot / web import (default when EB_* are empty).
# bank:   daily read-only PSD2 sync through Enable Banking; manual entry still works for cash.
# auto = bank if EB_APP_ID and EB_PRIVATE_KEY are set, manual otherwise.
ENTRY_MODE=auto
# App id of your Enable Banking application and the CONTENT of its .pem (never commit the file).
# On a host, paste the PEM as is (multi-line) in the dashboard.
EB_APP_ID=
EB_PRIVATE_KEY=
# Do not import movements before this date (yyyy-mm-dd), so nothing you typed by hand
# is duplicated. Empty = the 1st of the current month.
BANK_SYNC_FROM=
# Platforms used only to invest (comma list, matched inside the bank name). Money sent to
# them from your spending accounts is "Investment"; their own movements are ignored
# (only the cash balance counts). Empty = none.
INVESTMENT_BANKS=trade republic,myinvestor
# Country (2 letters) where those banks are looked up at Enable Banking.
BANK_COUNTRY=ES
# Daily cron: POST /tasks/banksync?token=<TASKS_TOKEN>  (e.g. 08:00)
